{
  "name": "@local-voice-agent/desktop",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "npm run build:electron && electron .",
    "build": "tsc -p tsconfig.node.json && vite build",
    "build:electron": "tsc -p tsconfig.node.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "start": "electron .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@local-voice-agent/shared": "*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^28.1.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  }
}
