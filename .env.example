# Environment Configuration
# Copy to .env and modify as needed

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# STT (whisper.cpp)
WHISPER_MODEL=tiny
WHISPER_BINARY_PATH=
WHISPER_MODELS_DIR=~/.local/share/whisper-models

# Backend
BACKEND_PORT=3399
BACKEND_HOST=localhost

# Web Search
SEARCH_ENABLED=true
SEARCH_PROVIDER=duckduckgo
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT=10000

# TTS
TTS_ENABLED=false
TTS_VOICE=Samantha
TTS_SPEED=175

# Privacy
LOG_CONVERSATIONS=false

# Debug
DEBUG=false
